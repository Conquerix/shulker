#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/toolchain
exec gcc -nostdinc -isystem "$root/include" -isystem "$(gcc -print-file-name=include)" -nostdlib -static-pie "$root/lib/rcrt1.o" "$root/lib/crti.o" "$(gcc -print-file-name=crtbeginS.o)" "$@" -L"$root/lib" -lc "$(gcc -print-libgcc-file-name)" "$(gcc -print-file-name=crtendS.o)" "$root/lib/crtn.o"
