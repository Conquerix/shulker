analytics_settings(False)
allow_k8s_contexts('kind-tuxee-trial')
custom_build('localhost/tuxee-trial-app', 'bash build.sh', ['Dockerfile', 'app'], disable_push=True, skips_local_docker=True, live_update=[sync('app', '/app')])
k8s_yaml('deployment.yaml')
k8s_resource('tuxee-trial-app', port_forwards=[port_forward(18080, 8080)])

docker_prune_settings(disable=True)
